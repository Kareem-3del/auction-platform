# Production Environment Variables Template
# Copy this to .env and update with your actual values
# IMPORTANT: Never commit the actual .env file to git

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL="postgresql://auction_user:CHANGE_THIS_PASSWORD@127.0.0.1:5432/auction_db"
REDIS_URL="redis://127.0.0.1:6379"

# ============================================
# JWT & AUTHENTICATION (CRITICAL - CHANGE THESE!)
# ============================================
# Generate strong secrets using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_THIS_TO_STRONG_RANDOM_SECRET_64_CHARS_MIN"
JWT_REFRESH_SECRET="CHANGE_THIS_TO_DIFFERENT_STRONG_RANDOM_SECRET_64_CHARS_MIN"
JWT_ACCESS_EXPIRES_IN="30m"
JWT_REFRESH_EXPIRES_IN="30d"

# ============================================
# GOOGLE OAUTH (CRITICAL - REGENERATE THESE!)
# ============================================
# SECURITY WARNING: Never expose these in .env file
# Create new OAuth credentials at: https://console.cloud.google.com
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_REDIRECT_URI="https://auction.lebanon-auction.bdaya.tech/api/auth/google/callback"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"

# ============================================
# APPLICATION URLs
# ============================================
NEXT_PUBLIC_APP_URL="https://auction.lebanon-auction.bdaya.tech"
NEXT_PUBLIC_SERVER_URL=""
NEXT_PUBLIC_ASSETS_DIR=""

# ============================================
# WEBSOCKET CONFIGURATION
# ============================================
WS_PORT=8081
NEXT_PUBLIC_WS_URL="wss://auction.lebanon-auction.bdaya.tech/ws/"

# ============================================
# EMAIL CONFIGURATION (PRODUCTION)
# ============================================
# SMTP Configuration (Primary)
SMTP_HOST="smtp.your-provider.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@domain.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="Lebanon Auction <noreply@lebanon-auction.bdaya.tech>"

# SendGrid Configuration (Fallback)
SENDGRID_API_KEY="YOUR_SENDGRID_API_KEY"

# Email Queue Configuration
REDIS_EMAIL_QUEUE_NAME="email-queue"
EMAIL_MAX_RETRIES="3"
EMAIL_RETRY_DELAY="60000"

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_AUTH_MAX="5"
RATE_LIMIT_BID_MAX="30"

# ============================================
# FILE UPLOAD LIMITS
# ============================================
MAX_FILE_SIZE="10485760"
MAX_IMAGE_WIDTH="4000"
MAX_IMAGE_HEIGHT="4000"
ALLOWED_IMAGE_TYPES="image/jpeg,image/png,image/webp"

# ============================================
# SECURITY HEADERS
# ============================================
ALLOWED_ORIGINS="https://auction.lebanon-auction.bdaya.tech"
CORS_CREDENTIALS="true"

# ============================================
# MONITORING & LOGGING
# ============================================
LOG_LEVEL="info"
ENABLE_REQUEST_LOGGING="true"
PROMETHEUS_PORT="9090"

# ============================================
# BACKUP CONFIGURATION
# ============================================
BACKUP_DIR="/var/backups/auction-platform"
BACKUP_RETENTION_DAYS="30"
POSTGRES_BACKUP_USER="auction_user"
POSTGRES_BACKUP_PASSWORD="CHANGE_THIS_PASSWORD"

# ============================================
# PAYMENT GATEWAYS (SIMULATED FOR TESTING)
# ============================================
# NOTE: These are simulated for testing stage
BINANCE_PAY_API_KEY="SIMULATED_FOR_TESTING"
BINANCE_PAY_SECRET="SIMULATED_FOR_TESTING"
WHISH_API_KEY="SIMULATED_FOR_TESTING"
WHISH_SECRET="SIMULATED_FOR_TESTING"

# ============================================
# THIRD-PARTY SERVICES (Optional)
# ============================================
NEXT_PUBLIC_MAPBOX_API_KEY=""
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APPID=""

# ============================================
# AWS CONFIGURATION (Optional)
# ============================================
NEXT_PUBLIC_AWS_AMPLIFY_USER_POOL_ID=""
NEXT_PUBLIC_AWS_AMPLIFY_USER_POOL_WEB_CLIENT_ID=""
NEXT_PUBLIC_AWS_AMPLIFY_REGION=""

# ============================================
# AUTH0 CONFIGURATION (Optional)
# ============================================
NEXT_PUBLIC_AUTH0_DOMAIN=""
NEXT_PUBLIC_AUTH0_CLIENT_ID=""
NEXT_PUBLIC_AUTH0_CALLBACK_URL=""

# ============================================
# SUPABASE CONFIGURATION (Optional)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV="production"
PORT="8083"
